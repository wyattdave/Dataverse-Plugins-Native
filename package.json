{
  "name": "dv-native",
  "version": "0.1.0",
  "private": true,
  "description": "Build and deploy Dataverse low-code plug-ins (instant Functions and automated plug-ins) via the Power Platform CLI; plus the Phase 1 read-only planning adapter.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "dv-native": "dist/src/cli/main.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "ui",
    "examples"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "dv-native": "node dist/src/cli/main.js",
    "ui": "npm run build && node dist/src/cli/main.js ui --open"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
